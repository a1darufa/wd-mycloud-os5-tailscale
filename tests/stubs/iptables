#!/bin/sh
# Stub iptables: only "iptables -t nat -L -n", the apps' check for the
# kernel's NAT table. Like the NAS's kernel, it has none, unless
# /tmp/kernel-has-nat exists.

if [ "$*" = "-t nat -L -n" ]; then
    if [ -f /tmp/kernel-has-nat ]; then
        printf 'Chain PREROUTING (policy ACCEPT)\ntarget     prot opt source               destination\n'
        exit 0
    fi
    echo "iptables v1.8.7 (legacy): can't initialize iptables table \`nat': Table does not exist (do you need to insmod?)" >&2
    exit 3
fi
echo "stub iptables: unsupported: $*" >&2
exit 2
